@Library('shared-library@main') _

pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                echo "Getting code from GitHub..."
                checkout scm
            }
        }

        stage('Run Unit Tests') {
            steps {
                echo "Running Maven unit tests..."
                sh 'mvn test'
            }
        }

        stage('Build Application') {
            steps {
                buildApp()
            }
        }

    }

    post {
        success {
            echo "Pipeline completed successfully!"
        }

        failure {
            echo "Pipeline failed!"
        }
    }
}
